                              "type": "Join",
                              "inputs": {
                                "from": "@body('Extraer_correos_de_solicitud_urgente_completada')",
                                "joinWith": ";"
                              }
                            },
                            "Enviar_solución_de_solicitud_urgente": {
                              "runAfter": {
                                "Unir_nombres_de_solicitud_urgente_completada": [
                                  "Succeeded"
