          "type": "Query",
          "inputs": {
            "from": "@outputs('Obtener_archivos_(solo_propiedades)')?['body/value']",
            "where": "@if(equals(toLower(outputs('Obtener_elemento_o_documento_registrado')?['body/Tipodecontribuyente/Value']), 'sucesoral'), contains(toLower(item()?['{FilenameWithExtension}']), 'sucesoral'), not(contains(toLower(item()?['{FilenameWithExtension}']), 'sucesoral')))"
