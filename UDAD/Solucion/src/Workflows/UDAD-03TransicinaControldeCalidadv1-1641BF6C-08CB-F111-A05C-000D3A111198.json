              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                  "table": "4e0c3969-3f15-4c08-9b51-d7bd81462355",
                  "$filter": "@concat('No_Caja eq ''',replace(triggerBody()?['No_Caja'],'''',''''''),''' and Orden eq ',string(triggerBody()?['Orden']))",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Condición_-_Es_primera_digitalización": {
              "actions": {
                "Condición_-_Documento_no_existe_en_Calidad": {
                  "actions": {
                    "Crear_elemento_documento_en_Control_de_Calidad": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                          "table": "4e0c3969-3f15-4c08-9b51-d7bd81462355",
                          "item/Title": "@triggerBody()?['Title']",
                          "item/No_Caja": "@triggerBody()?['No_Caja']",
                          "item/Orden": "@triggerBody()?['Orden']",
                          "item/Area_Procedencia": "@triggerBody()?['Area_Procedencia']",
                          "item/Tipo_Documento": "@triggerBody()?['Tipo_documento']",
                          "item/Razon_Social": "@triggerBody()?['Razon_Social']",
                          "item/RNC": "@triggerBody()?['RNC']",
                          "item/Tipo_Error": [
                            {
                              "Value": "Pendiente de revisión"
                            }
                          ],
                          "item/Prioridad/Value": "@triggerBody()?['Prioridad/Value']",
                          "item/Estado/Value": "Pendiente"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PostItem"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Obtener_documentos_caja_Digitalización": {
                      "runAfter": {
                        "Filtrar_documentos_vigentes_de_Preparación_para_validar_digitalización": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                          "table": "da7c1e85-52c4-4c25-829c-8ba4e5885cfd",
                          "$filter": "@concat('No_Caja eq ''', replace(triggerBody()?['No_Caja'], '''', ''''''), '''')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runtimeConfiguration": {
                        "paginationPolicy": {
                          "minimumItemCount": 5000
                        }
                      }
                    },
                    "Obtener_documentos_caja_Calidad": {
                      "runAfter": {
                        "Obtener_documentos_caja_Digitalización": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                          "table": "4e0c3969-3f15-4c08-9b51-d7bd81462355",
                          "$filter": "@concat('No_Caja eq ''', replace(triggerBody()?['No_Caja'], '''', ''''''), '''')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runtimeConfiguration": {
                        "paginationPolicy": {
                          "minimumItemCount": 5000
                        }
                      }
                    },
                    "Obtener_último_documento_transferido_a_Calidad": {
                      "runAfter": {
                        "Obtener_documentos_caja_Calidad": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                          "table": "4e0c3969-3f15-4c08-9b51-d7bd81462355",
                          "$filter": "@concat('No_Caja eq ''', replace(triggerBody()?['No_Caja'], '''', ''''''), '''')",
                          "$orderby": "ID desc",
                          "$top": 1
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Condición_-_Caja_digitalizada_completamente": {
                      "actions": {
                        "Publicar_mensaje_en_un_chat_o_canal_1": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "poster": "User",
                              "location": "Channel",
                              "body/recipient/groupId": "79d87419-38dc-4f32-b48a-6ee69cb7ce88",
                              "body/recipient/channelId": "19:-FIOKwDdiUTkcGiKbQKDBddxH-leFY_ns1lBYpujKvQ1@thread.tacv2",
                              "body/messageBody": "<p class=\"editor-paragraph\">DIGITALIZACIÓN COMPLETADA - @{triggerBody()?['No_Caja']}<br><br>La digitalización fue completada correctamente por @{triggerBody()?['Editor/DisplayName']}.<br><br>Cantidad de documentos digitalizados: @{length(\r\n    body('Filtrar_documentos_vigentes_de_Preparación_para_validar_digitalización')\r\n)}<br>Área de procedencia: @{triggerBody()?['Area_Procedencia']}<br>Tipo de documento: @{triggerBody()?['Tipo_documento']}<br><br>Los documentos ya están disponibles para su revisión de calidad.</p>"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                              "connectionName": "shared_teams",
                              "operationId": "PostMessageToConversation"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "runAfter": {
                        "Obtener_último_documento_transferido_a_Calidad": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {}
                      },
                      "expression": {
                        "and": [
                          {
                            "greater": [
                              "@length(\r\n    body('Filtrar_documentos_vigentes_de_Preparación_para_validar_digitalización')\r\n)",
                              0
                            ]
                          },
                          {
                            "equals": [
                              "@length(\r\n    body('Filtrar_documentos_vigentes_de_Preparación_para_validar_digitalización')\r\n)",
                              "@length(\r\n    outputs('Obtener_documentos_caja_Digitalización')?['body/value']\r\n)"
                            ]
                          },
                          {
                            "greater": [
                              "@length(\r\n    outputs('Obtener_documentos_caja_Digitalización')?['body/value']\r\n)",
                              0
                            ]
                          },
                          {
                            "equals": [
                              "@length(\r\n    outputs('Obtener_documentos_caja_Digitalización')?['body/value']\r\n)",
                              "@length(\r\n    outputs('Obtener_documentos_caja_Calidad')?['body/value']\r\n)"
                            ]
                          },
                          {
                            "equals": [
                              "@int(\r\n    outputs('Crear_elemento_documento_en_Control_de_Calidad')?['body/ID']\r\n)",
                              "@int(\r\n    first(\r\n        outputs('Obtener_último_documento_transferido_a_Calidad')?['body/value']\r\n    )?['ID']\r\n)"
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    },
