                        "01PZOABV2YLP37AQJRENC2M4F6YXSFMQJO": "/Datos de UDAD.xlsx",
                        "tableId": "{C4A9A1EF-0D0D-4932-9EB0-4BEA5C05B9A3}"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "source": "sites/dgii.sharepoint.com,9fb29c9a-92fe-4b1d-a300-d5fd5d0e678b,223e575d-6efe-4be0-abb4-b357de0915b6",
                          "drive": "b!mpyyn_6SHUujANX9XQ5ni11XPiL-buBLq7SzV94JFba9evj-sofcRrIkemVbVw-e",
                          "file": "01PZOABV2YLP37AQJRENC2M4F6YXSFMQJO",
                          "table": "{C4A9A1EF-0D0D-4932-9EB0-4BEA5C05B9A3}",
                          "item/Evento_ID": "@concat(\r\n    'DIG|',\r\n    string(triggerBody()?['ID'])\r\n)",
                          "item/Fecha_Evento": "@convertTimeZone(\r\n    triggerBody()?['Modified'],\r\n    'UTC',\r\n    'SA Western Standard Time',\r\n    'yyyy-MM-dd HH:mm'\r\n)",
                          "item/Fecha_Creacion": "@convertTimeZone(\r\n    triggerBody()?['Created'],\r\n    'UTC',\r\n    'SA Western Standard Time',\r\n    'yyyy-MM-dd HH:mm'\r\n)",
                          "item/Duracion_Minutos": "@div(\r\n    float(\r\n        sub(\r\n            ticks(triggerBody()?['Modified']),\r\n            ticks(triggerBody()?['Created'])\r\n        )\r\n    ),\r\n    600000000\r\n)",
                          "item/ID_SharePoint": "@triggerBody()?['ID']",
                          "item/No_Caja": "@triggerBody()?['No_Caja']",
                          "item/No_Documento": "@triggerBody()?['Title']",
                          "item/Orden": "@triggerBody()?['Orden']",
                          "item/RNC": "@triggerBody()?['RNC']",
                          "item/Razon_Social": "@triggerBody()?['Razon_Social']",
                          "item/Area_Procedencia": "@triggerBody()?['Area_Procedencia']",
                          "item/Tipo_Documento": "@triggerBody()?['Tipo_documento']",
                          "item/Prioridad": "@triggerBody()?['Prioridad']?['Value']",
                          "item/Estado": "@triggerBody()?['Estado']?['Value']",
                          "item/Tipo_Evento": "Documento digitalizado",
                          "item/Tiene_Error": "No",
                          "item/Usuario_Email": "@triggerBody()?['Editor']?['Email']",
                          "item/Usuario_Nombre": "@triggerBody()?['Editor']?['DisplayName']"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
                          "connectionName": "shared_excelonlinebusiness",
                          "operationId": "AddRowV2"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Obtener_documentos_caja_Preparación_para_validar_digitalización": {
                      "runAfter": {
                        "Registrar_documento_digitalizado_en_Excel": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                          "table": "703c3ca4-e74b-40e1-8419-1fb69be74872",
                          "$filter": "@concat(\r\n    'No_Caja eq ''',\r\n    replace(\r\n        triggerBody()?['No_Caja'],\r\n        '''',\r\n        ''''''\r\n    ),\r\n    ''''\r\n)"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runtimeConfiguration": {
                        "paginationPolicy": {
                          "minimumItemCount": 5000
                        }
                      }
                    },
                    "Filtrar_documentos_vigentes_de_Preparación_para_validar_digitalización": {
                      "runAfter": {
                        "Obtener_documentos_caja_Preparación_para_validar_digitalización": [
