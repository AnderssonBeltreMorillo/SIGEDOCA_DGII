                              "inputs": {
                                "from": "@items('Procesar_cada_solicitud_urgente')?['Responsable_Notificacion']",
                                "select": "@item()?['DisplayName']"
                              }
                            },
                            "Unir_nombres_de_solicitud_urgente_completada": {
                              "runAfter": {
                                "Extraer_nombres_de_solicitud_urgente_completada": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Join",
                              "inputs": {
                                "from": "@body('Extraer_nombres_de_solicitud_urgente_completada')",
                                "joinWith": ", "
                              }
                            },
