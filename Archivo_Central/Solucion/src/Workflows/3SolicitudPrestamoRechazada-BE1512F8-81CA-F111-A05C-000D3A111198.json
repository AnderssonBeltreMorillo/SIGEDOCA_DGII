                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "poster": "User",
                      "location": "Group chat",
                      "body/recipient": "19:4da3541bb907484c810648e57f1de607@thread.v2",
                      "body/messageBody": "<p class=\"editor-paragraph\">Los datos de la solicitud con ID GDP@{triggerBody()?['ID']} son incorrectos, fueron revisados por @{triggerBody()?['Editor/DisplayName']}.</p>"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                      "connectionName": "shared_teams-2",
                      "operationId": "PostMessageToConversation"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {
                "Datos_incompletos": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@triggerBody()?['Tipodeaprobaci_x00f3_n_x002e_/Value']",
