                            "item/Orden": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Orden']",
                            "item/Area_Procedencia": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Area_Procedencia']",
                            "item/Tipo_Documento": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Tipo_Documento']",
                            "item/Razon_Social": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Razon_Social']",
                            "item/RNC": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['RNC']",
                            "item/Tipo_Error": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Tipo_Error']",
                            "item/Title": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Title']",
                            "item/Prioridad/Value": "URGENTE",
                            "item/Estado/Value": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Estado']?['Value']"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    }
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Prioridad']?['Value']",
                          "URGENTE"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                },
                "Determinar_estado_del_documento_urgente_en_Calidad": {
                  "runAfter": {
                    "Preparar_responsables_para_actualizar_solicitud_en_Calidad": [
