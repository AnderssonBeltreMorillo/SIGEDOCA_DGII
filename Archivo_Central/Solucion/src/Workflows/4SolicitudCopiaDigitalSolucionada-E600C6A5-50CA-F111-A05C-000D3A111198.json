{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sigedoca_sharedsharepointonline_ce3d3"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_teams-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sigedoca_sharedteams_764af"
        },
        "api": {
          "name": "shared_teams"
        }
      },
      "shared_office365-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sigedoca_sharedoffice365_d63d9"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Cuando_se_crea_o_se_modifica_un_elemento": {
          "recurrence": {
            "frequency": "Minute",
            "interval": 5
          },
          "evaluatedRecurrence": {
            "frequency": "Minute",
            "interval": 5
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
              "table": "887a60dd-dd10-4fa4-ac8f-34d7b154d80a"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline-1",
              "operationId": "GetOnUpdatedItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Seleccionar_Tipo_de_Documento": {
          "runAfter": {},
          "type": "Select",
          "inputs": {
            "from": "@triggerBody()?['TipodeDocumento']",
            "select": {
              "Value": "@item()?['Value']"
            }
          }
        },
        "Combinación": {
          "runAfter": {
            "Seleccionar_Correos_en_copia": [
              "Succeeded"
            ]
          },
          "type": "Join",
          "inputs": {
            "from": "@body('Seleccionar_Tipo_de_Documento')",
            "joinWith": ", "
          }
        },
        "Seleccionar_Correos_en_copia": {
          "runAfter": {
            "Seleccionar_Tipo_de_Documento": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@triggerBody()?['Copiar_x0020_a_x003a_']",
            "select": "@item()?['Email']"
          }
        },
        "Combinación_Correos_en_copia": {
          "runAfter": {
            "Combinación": [
              "Succeeded"
            ]
          },
          "type": "Join",
          "inputs": {
            "from": "@body('Seleccionar_Correos_en_copia')",
            "joinWith": "; "
          }
        },
        "Obtener_cambios_para_un_elemento_o_archivo_(solo_propiedades)": {
          "runAfter": {
            "Combinación_Correos_en_copia": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
              "table": "887a60dd-dd10-4fa4-ac8f-34d7b154d80a",
              "id": "@triggerBody()?['ID']",
              "since": "@triggerBody()?['{TriggerWindowStartToken}']",
              "includeDrafts": false,
              "until": "@triggerBody()?['{TriggerWindowEndToken}']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline-1",
              "operationId": "GetItemChanges"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condición": {
          "actions": {
            "Solucionado": {
              "actions": {
                "Entregado": {
                  "actions": {
                    "Publicar_mensaje_en_un_chat_o_canal": {
                      "runAfter": {
                        "For_each": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "poster": "User",
                          "location": "Group chat",
                          "body/recipient": "19:4da3541bb907484c810648e57f1de607@thread.v2",
                          "body/messageBody": "<p class=\"editor-paragraph\">Solicitud con ID GDC@{triggerBody()?['ID']} ha sido solucionada por @{triggerBody()?['Editor/DisplayName']}.</p>"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                          "connectionName": "shared_teams-1",
                          "operationId": "PostMessageToConversation"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Obtener_correos_electrónicos_(V3)": {
                      "metadata": {
                        "Id::AAMkADI1NWM0ZmZkLTdkMTUtNDI2Mi1iYTI2LTk0YzJiYzlmZTdkYwAuAAAAAABtM7HjYYWFS7-uEirtdxDHAQBmerdE1rWKTJsghYAk_6xjAAAAAAEJAAA=": "Sent Items"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "folderPath": "Id::AAMkADI1NWM0ZmZkLTdkMTUtNDI2Mi1iYTI2LTk0YzJiYzlmZTdkYwAuAAAAAABtM7HjYYWFS7-uEirtdxDHAQBmerdE1rWKTJsghYAk_6xjAAAAAAEJAAA=",
                          "fetchOnlyUnread": false,
                          "searchQuery": "GDC@{triggerBody()?['ID']}",
                          "top": 1
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365-1",
                          "operationId": "GetEmailsV3"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "For_each": {
                      "foreach": "@outputs('Obtener_correos_electrónicos_(V3)')?['body/value']",
                      "actions": {
                        "Responder_al_correo_electrónico_(V3)": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "messageId": "@items('For_each')?['id']",
                              "replyParameters/To": "@items('For_each')?['toRecipients']",
                              "replyParameters/Cc": "@items('For_each')?['ccRecipients']",
                              "replyParameters/Importance": "Normal",
                              "replyParameters/Body": "<p class=\"editor-paragraph\">Estimado/a @{triggerBody()?['Author/DisplayName']},<br><br>Nos complace informarle que su solicitud con ID GDC@{triggerBody()?['ID']} ha sido solucionada. Su solicitud fue una copia digital de documentos y/o expedientes, a continuación enlace al documento el cual expira en 5 días: @{triggerBody()?['Documentosolicitado']}<br><br>Buscamos reducir la generación de copias de documentos para reducir costes y espacio físico, por ello protegemos el documento evitando su impresión. Si requiere imprimirlo para entrega al contribuyente favor informarlo.<br><br>Si tiene alguna pregunta o inquietud, no dude en contactarnos.<br><br>Atentamente,<br>@{triggerBody()?['Editor/DisplayName']}<br>Equipo de Gestión Documental.</p>"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "connectionName": "shared_office365-1",
                              "operationId": "ReplyToV3"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "runAfter": {
                        "Obtener_correos_electrónicos_(V3)": [
                          "Succeeded"
                        ]
                      },
                      "type": "Foreach"
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@triggerBody()?['Tipodeaprobaci_x00f3_n_x002e_/Value']",
                          "Entregado"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@triggerBody()?['Estado/Value']",
                      "Solucionado"
                    ]
                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Obtener_cambios_para_un_elemento_o_archivo_(solo_propiedades)": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Obtener_cambios_para_un_elemento_o_archivo_(solo_propiedades)')?['body/ColumnHasChanged/Tipodeaprobaci_x00f3_n_x002e_']",
                  "@true"
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}