                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                                  "table": "272827df-d57d-409c-896c-4f2975a4e4bf",
                                  "id": "@items('Procesar_cada_solicitud_urgente')?['ID']",
                                  "item/Title": "@items('Procesar_cada_solicitud_urgente')?['Title']",
                                  "item/RNC": "@items('Procesar_cada_solicitud_urgente')?['RNC']",
                                  "item/Responsable_Notificacion": "@body('Preparar_responsables_para_actualizar_solicitud_en_Calidad')",
                                  "item/Prioridad_Aplicada": true,
                                  "item/Razcon_Social": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['Razon_Social']",
                                  "item/No_Caja_Localizada": "@first(\r\n    outputs('Buscar_documento_urgente_en_Control_de_Calidad')?['body/value']\r\n)?['No_Caja']",
                                  "item/Estado_Solicitud/Value": "Completada",
                                  "item/Etapa_Localizada/Value": "Finalizada",
                                  "item/Notificacion_Enviada": true,
                                  "item/Observaciones": "@items('Procesar_cada_solicitud_urgente')?['Observaciones']"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "PatchItem"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          },
                          "else": {
                            "actions": {}
                          },
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@coalesce(\r\n    items('Procesar_cada_solicitud_urgente')?['Notificacion_Enviada'],\r\n    false\r\n)",
                                  "@false"
                                ]
                              }
                            ]
                          },
                          "type": "If"
                        }
                      }
                    }
                  },
                  "default": {
