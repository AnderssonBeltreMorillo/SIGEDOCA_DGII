                "parameters": {
                  "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                  "table": "4e0c3969-3f15-4c08-9b51-d7bd81462355",
                  "$filter": "@concat(\r\n    'Title eq ''',\r\n    replace(items('Procesar_cada_solicitud_urgente')?['Title'], '''', ''''''),\r\n    ''' and RNC eq ''',\r\n    replace(items('Procesar_cada_solicitud_urgente')?['RNC'], '''', ''''''),\r\n    ''''\r\n)",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
