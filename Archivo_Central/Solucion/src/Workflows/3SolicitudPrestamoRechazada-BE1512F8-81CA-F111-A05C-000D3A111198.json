                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Combinación_Copiar_a": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerBody()?['Estado/Value']",
                  "Rechazado"
                ]
              }
            ]
          },
          "type": "If"
        },
        "Seleccionar_Copiar_a": {
          "runAfter": {},
          "type": "Select",
          "inputs": {
            "from": "@triggerBody()?['Copiar_x0020_a_x003a_']",
            "select": "@item()?['Email']"
          }
        },
        "Combinación_Copiar_a": {
          "runAfter": {
            "Seleccionar_Copiar_a": [
              "Succeeded"
            ]
          },
          "type": "Join",
          "inputs": {
            "from": "@body('Seleccionar_Copiar_a')",
            "joinWith": "; "
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
