                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('Obtener_documentos_caja_Preparación_para_validar_digitalización')?['body/value']",
                        "where": "@not(equals(item()?['Estado']?['Value'],'No recibido'))"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@length(\r\n    outputs('Obtener_elementos_Buscar_documento_en_Control_de_Calidad')?['body/value']\r\n)",
                          0
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Obtener_elementos_Buscar_documento_en_Control_de_Calidad": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Condición_-_Documento_existe_para_nueva_revisión": {
                    "actions": {
                      "Reenviar_documento_corregido_a_Calidad": {
                        "runAfter": {
                          "Preparar_errores_para_reenviar_a_Calidad": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "dataset": "https://dgii.sharepoint.com/sites/GestionDocumentalDGII",
                            "table": "4e0c3969-3f15-4c08-9b51-d7bd81462355",
                            "id": "@first(\r\n    outputs('Obtener_elementos_Buscar_documento_en_Control_de_Calidad')?['body/value']\r\n)?['ID']",
                            "item/Title": "@triggerBody()?['Title']",
                            "item/No_Caja": "@triggerBody()?['No_Caja']",
                            "item/Orden": "@triggerBody()?['Orden']",
                            "item/Area_Procedencia": "@triggerBody()?['Area_Procedencia']",
                            "item/Tipo_Documento": "@triggerBody()?['Tipo_documento']",
                            "item/Razon_Social": "@triggerBody()?['Razon_Social']",
                            "item/RNC": "@triggerBody()?['RNC']",
                            "item/Tipo_Error": "@body('Preparar_errores_para_reenviar_a_Calidad')",
                            "item/Prioridad/Value": "@triggerBody()?['Prioridad/Value']",
                            "item/Estado/Value": "Corregido"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Condición_-_Existe_tarea_de_Planner": {
                        "actions": {
                          "Marcar_tarea_en_curso": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "parameters": {
                                "id": "@triggerBody()?['Planner_Task_ID']",
                                "body/percentComplete": "In Progress"
                              },
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_planner",
                                "connectionName": "shared_planner",
                                "operationId": "UpdateTask_V2"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        },
                        "runAfter": {
                          "Reenviar_documento_corregido_a_Calidad": [
                            "Succeeded"
                          ]
                        },
                        "else": {
                          "actions": {}
                        },
                        "expression": {
                          "and": [
                            {
                              "equals": [
                                "@empty(\r\n    coalesce(\r\n        triggerBody()?['Planner_Task_ID'],\r\n        ''\r\n    )\r\n)",
                                "@false"
                              ]
                            }
                          ]
                        },
                        "type": "If"
                      },
                      "Extraer_errores_de_corrección_para_Excel": {
                        "runAfter": {
                          "Reenviar_documento_corregido_a_Calidad": [
                            "Succeeded"
                          ]
                        },
                        "type": "Select",
                        "inputs": {
                          "from": "@first(\r\n    outputs('Obtener_elementos_Buscar_documento_en_Control_de_Calidad')?['body/value']\r\n)?['Tipo_Error']\r\n",
                          "select": "@item()?['Value']"
                        }
                      },
                      "Unir_errores_de_corrección_para_Excel": {
                        "runAfter": {
                          "Extraer_errores_de_corrección_para_Excel": [
                            "Succeeded"
                          ]
                        },
                        "type": "Join",
                        "inputs": {
                          "from": "@body('Extraer_errores_de_corrección_para_Excel')",
                          "joinWith": ", "
                        }
                      },
                      "Registrar_documento_corregido_en_Excel": {
                        "runAfter": {
                          "Unir_errores_de_corrección_para_Excel": [
                            "Succeeded"
                          ]
                        },
                        "metadata": {
                          "01PZOABV2YLP37AQJRENC2M4F6YXSFMQJO": "/Datos de UDAD.xlsx",
                          "tableId": "{C4A9A1EF-0D0D-4932-9EB0-4BEA5C05B9A3}"
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "source": "sites/dgii.sharepoint.com,9fb29c9a-92fe-4b1d-a300-d5fd5d0e678b,223e575d-6efe-4be0-abb4-b357de0915b6",
                            "drive": "b!mpyyn_6SHUujANX9XQ5ni11XPiL-buBLq7SzV94JFba9evj-sofcRrIkemVbVw-e",
                            "file": "01PZOABV2YLP37AQJRENC2M4F6YXSFMQJO",
                            "table": "{C4A9A1EF-0D0D-4932-9EB0-4BEA5C05B9A3}",
                            "item/Evento_ID": "@concat(\r\n    'CORR|',\r\n    string(triggerBody()?['ID']),\r\n    '|',\r\n    string(ticks(triggerBody()?['Modified']))\r\n)",
                            "item/Fecha_Evento": "@convertTimeZone(\r\n    triggerBody()?['Modified'],\r\n    'UTC',\r\n    'SA Western Standard Time',\r\n    'yyyy-MM-dd HH:mm'\r\n)",
                            "item/Fecha_Creacion": "@convertTimeZone(\r\n    triggerBody()?['Created'],\r\n    'UTC',\r\n    'SA Western Standard Time',\r\n    'yyyy-MM-dd HH:mm'\r\n)",
                            "item/ID_SharePoint": "@triggerBody()?['ID']",
                            "item/No_Caja": "@triggerBody()?['No_Caja']",
                            "item/No_Documento": "@triggerBody()?['Title']",
                            "item/Orden": "@triggerBody()?['Orden']",
                            "item/RNC": "@triggerBody()?['RNC']",
                            "item/Razon_Social": "@triggerBody()?['Razon_Social']",
                            "item/Area_Procedencia": "@triggerBody()?['Area_Procedencia']",
                            "item/Tipo_Documento": "@triggerBody()?['Tipo_documento']",
                            "item/Prioridad": "@triggerBody()?['Prioridad']?['Value']",
                            "item/Estado": "@triggerBody()?['Estado']?['Value']",
                            "item/Tipo_Evento": "Documento corregido",
                            "item/Tiene_Error": "Sí",
                            "item/Tipos_Error": "@body('Unir_errores_de_corrección_para_Excel')",
                            "item/Usuario_Email": "@triggerBody()?['Editor']?['Email']",
                            "item/Usuario_Nombre": "@triggerBody()?['Editor']?['DisplayName']",
                            "item/Planner_Task_ID": "@triggerBody()?['Planner_Task_ID']"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
                            "connectionName": "shared_excelonlinebusiness",
                            "operationId": "AddRowV2"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Preparar_errores_para_reenviar_a_Calidad": {
                        "type": "Select",
                        "inputs": {
                          "from": "@first(\r\n    outputs('Obtener_elementos_Buscar_documento_en_Control_de_Calidad')?['body/value']\r\n)?['Tipo_Error']",
                          "select": {
                            "Value": "@item()?['Value']"
                          }
                        }
                      }
                    },
                    "else": {
