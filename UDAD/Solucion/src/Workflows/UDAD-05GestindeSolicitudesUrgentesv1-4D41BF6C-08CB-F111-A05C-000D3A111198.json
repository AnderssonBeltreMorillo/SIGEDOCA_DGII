                                  "item/No_Caja": "@first(\r\n    outputs('Buscar_documento_urgente_en_Digitalización')?['body/value']\r\n)?['No_Caja']",
                                  "item/Orden": "@first(\r\n    outputs('Buscar_documento_urgente_en_Digitalización')?['body/value']\r\n)?['Orden']",
                                  "item/Area_Procedencia": "@first(\r\n    outputs('Buscar_documento_urgente_en_Digitalización')?['body/value']\r\n)?['Area_Procedencia']",
                                  "item/Tipo_documento": "@first(\r\n    outputs('Buscar_documento_urgente_en_Digitalización')?['body/value']\r\n)?['Tipo_Documento']",
                                  "item/Razon_Social": "@first(\r\n    outputs('Buscar_documento_urgente_en_Digitalización')?['body/value']\r\n)?['Razon_Social']",
                                  "item/RNC": "@first(\r\n    outputs('Buscar_documento_urgente_en_Digitalización')?['body/value']\r\n)?['RNC']",
                                  "item/Title": "@first(\r\n    outputs('Buscar_documento_urgente_en_Digitalización')?['body/value']\r\n)?['Title']",
